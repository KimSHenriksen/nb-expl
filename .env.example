# Any OpenAI-compatible endpoint: Plexus proxy, Ollama, LM Studio, vLLM, Gemini's OpenAI endpoint, ...
OPENAI_BASE_URL=http://localhost:PORT/v1
OPENAI_API_KEY=changeme

# Model used for claim extraction and document writing (may be set separately)
MODEL_EXTRACT=qwen3.8
MODEL_WRITE=qwen3.8
# Optional: a different/stronger model for verifying claims (defaults to MODEL_EXTRACT)
# MODEL_VERIFY=

# Structured output mode: auto | json_schema | json_object | prompt
STRUCTURED_OUTPUT=auto

# Provider-specific request fields (JSON). Qwen3 on vLLM: turn off hidden "thinking",
# which otherwise uses up MAX_TOKENS before the JSON answer is written.
LLM_EXTRA_BODY={"chat_template_kwargs": {"enable_thinking": false}}
MAX_TOKENS=8192

# Parallel requests; only helps if the server runs several requests at once
CONCURRENCY=1
# Notebook lines per extraction request (smaller = shorter answers, more calls)
CHUNK_LINES=150

# Where LLM responses are cached (keyed by notebook + prompt + model)
CACHE_DIR=.cache
